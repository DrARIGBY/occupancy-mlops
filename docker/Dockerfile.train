# Training pipeline image (Task 3): python -m occupancy.train
# Data and models are mounted at run time:
#   docker run --rm -v "$PWD/data:/app/data:ro" -v "$PWD/models:/app/models" occupancy-train
FROM python:3.12-slim

ENV OCC_DATA_DIR=/app/data/raw \
    OCC_MODEL_DIR=/app/models

# XGBoost needs the OpenMP runtime.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
# Pinned dependencies first (cached layer), then the occupancy package itself.
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY pyproject.toml ./
COPY src ./src
RUN pip install --no-cache-dir --no-deps .

ENTRYPOINT ["python", "-m", "occupancy.train"]
